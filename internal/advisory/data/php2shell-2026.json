  "summary": {
    "en": "Two memory-safety flaws in the PHP engine let an unauthenticated HTTP request corrupt request state (through out-of-memory bailouts) or reuse freed global state in a later request on the same worker, leading to remote code execution as the web worker account. Apache mod_php is confirmed exploitable; PHP-FPM, FrankenPHP and LiteSpeed are considered likely susceptible."
  },
  "sapi_risk": {
    "apache2handler": {
      "level": "confirmed",
      "en": "Exploit demonstrated against mod_php: the request can trigger the bug before any application code runs."
    },
    "fpm": {
      "level": "likely",
      "en": "Likely susceptible per source analysis; the session upload progress path was validated against PHP-FPM."
    },
    "litespeed": {
      "level": "likely",
      "en": "Considered likely susceptible (LSAPI), not validated."
    },
    "cgi": {
      "level": "likely",
      "en": "Serves web requests; treat as exposed."
    },
    "cli": {
      "level": "low",
      "en": "The CLI binary does not serve HTTP itself, but it usually shares a build with the web SAPIs on the same host."
    }
  },
