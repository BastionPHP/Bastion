  "fingerprints": [
    {
      "kind": "binary-string",
      "value": "Hard memory limit of",
      "indicates": "fixed",
      "min_branch": "8.2",
      "note": {
        "en": "The fix replaces longjmp-based OOM handling with a soft limit plus a hard limit; the 'Hard memory limit of %zu bytes exhausted' message only exists in patched builds (php-src 8.2.35+ and vendor ports of that patch). The minimal 7.4/8.0/8.1 source backports do not add it, so its absence proves nothing."
      }
    }
  ],
  "mitigations": [
    {
      "en": "Update to 8.5.12, 8.4.27, 8.3.36 or 8.2.35 (or your vendor's patched package). This is the only complete fix."
    },
    {
      "en": "Restart every PHP worker after updating (php-fpm, Apache, LiteSpeed). Updated files on disk do nothing for workers that are still running the old code."
    },
    {
      "en": "If you cannot update yet: set session.upload_progress.enabled=0 in php.ini or the FPM pool (not via ini_set or .user.ini) and restart workers."
    },
    {
      "en": "On PHP 8.5 that cannot be updated, set fatal_error_backtraces=0 and restart workers."
    },
    {
      "en": "Reduce exposure: enforce memory_limit=-1 administratively (php_admin_value), keep post_max_size low (8M without uploads, 32M with), and cap request size, part count and header count at the web server or proxy. These narrow known paths but do not make an installation safe."
    },
    {
      "en": "Do not use RLIMIT_AS / RLIMIT_DATA as a memory boundary; they can cause the vulnerable allocation failure. Use cgroup/container limits instead."
    }
  ],
  "config_checks": [
    {
      "setting": "session.upload_progress.enabled",
      "default": "1",
      "safe": "off",
      "text": {
        "en": "Blocks the confirmed session upload progress path of CVE-2026-109619. Must be set in php.ini or the FPM pool, not .user.ini or ini_set()."
      }
    },
    {
      "setting": "memory_limit",
      "default": "128M",
      "safe": "-1",
      "text": {
        "en": "Removes the controllable memory_limit failure behind CVE-2026-109618 (set administratively, e.g. php_admin_value). Real allocation failures can still reach the bug."
      }
    },
    {
      "setting": "post_max_size",
      "default": "8M",
      "safe": "<=32M",
      "text": {
        "en": "Smaller request bodies make it harder to push request parsing into out-of-memory. 8M without uploads, 32M with uploads."
      }
    },
    {
      "setting": "fatal_error_backtraces",
      "default": "1",
      "safe": "off",
      "branches": [
        "8.5",
        "8.6"
      ],
      "text": {
        "en": "Blocks the confirmed fatal-error backtrace path on PHP 8.5."
      }
    }
  ],
