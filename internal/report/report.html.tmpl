<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<meta name="robots" content="noindex">
<title>Bastion report · {{if .Scan}}{{.Scan.Host.Hostname}}{{else if .Trace}}{{.Trace.Hostname}}{{end}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<header class="r-top no-print-bg">
  <div class="bx-wrap r-top-in">
    <span class="bx-logo">{{.Logo}} Bastion <span class="bx-faint r-sub">report</span></span>
    <div class="r-top-actions no-print">
      <div class="bx-seg" role="group" aria-label="Theme"><button type="button" data-set-theme="dark" aria-pressed="false" title="Dark">◐</button><button type="button" data-set-theme="light" aria-pressed="false" title="Light">○</button></div>
      <button type="button" class="bx-btn is-sm" data-print>Print / PDF</button>
    </div>
  </div>
</header>

<main class="bx-wrap r-main">
  <section class="r-hero">
    <div class="bx-eyebrow">Local security report</div>
    <h1 class="r-host mono">{{if .Scan}}{{.Scan.Host.Hostname}}{{else if .Trace}}{{.Trace.Hostname}}{{end}}</h1>
    <dl class="bx-kv r-meta">
      {{with .Scan}}<dt>os</dt><dd>{{.Host.OS.Pretty}}{{if .Host.Kernel}} <span class="bx-faint">· kernel {{.Host.Kernel}}</span>{{end}}</dd>{{end}}
      <dt>generated</dt><dd class="mono">{{.Generated}} · bastion {{.Version}}</dd>
      {{with .Scan}}<dt>privileges</dt><dd>{{if .Host.Root}}root{{else}}unprivileged — results may be incomplete{{end}}</dd>{{end}}
    </dl>
  </section>

  <section class="r-verdicts">
    {{if .Scan}}
    <a class="bx-card r-verdict" data-tone="{{.Worst}}" href="#exposure">
      <div class="bx-eyebrow">01 · Vulnerability exposure</div>
      <div class="r-verdict-main"><span class="bx-badge" data-status="{{.Worst}}">{{.WorstEn}}</span></div>
      <div class="r-bars">
        {{$total := len .Instances}}
        <div class="r-bar" aria-hidden="true">
          <i style="--w:{{pct (index .Counts "vulnerable") $total}}%" data-status="vulnerable"></i><i style="--w:{{pct (index .Counts "likely-vulnerable") $total}}%" data-status="likely-vulnerable"></i><i style="--w:{{pct (index .Counts "unknown") $total}}%" data-status="unknown"></i><i style="--w:{{pct (index .Counts "fixed") $total}}%" data-status="fixed"></i>
        </div>
        <ul class="r-legend mono">
          <li data-status="vulnerable"><b>{{index .Counts "vulnerable"}}</b> vulnerable</li>
          <li data-status="likely-vulnerable"><b>{{index .Counts "likely-vulnerable"}}</b> likely</li>
          <li data-status="unknown"><b>{{index .Counts "unknown"}}</b> unknown</li>
          <li data-status="fixed"><b>{{index .Counts "fixed"}}</b> fixed</li>
        </ul>
      </div>
      <p class="bx-muted r-verdict-note">{{len .Instances}} PHP builds across {{len .Scan.Targets}} targets (host, containers, namespaces).</p>
    </a>
    {{end}}
    {{if .Trace}}
    <a class="bx-card r-verdict" data-tone="{{.Trace.Verdict}}" href="#trace">
      <div class="bx-eyebrow">02 · Intrusion trace</div>
      <div class="r-verdict-main"><span class="bx-badge" data-verdict="{{.Trace.Verdict}}">{{.VerdictEn}}</span></div>
      <ul class="r-legend mono r-legend-sev">
        <li data-sev="high"><b>{{index .TraceCounts "high"}}</b> high</li>
        <li data-sev="medium"><b>{{index .TraceCounts "medium"}}</b> medium</li>
        <li data-sev="low"><b>{{index .TraceCounts "low"}}</b> low</li>
        <li data-sev="info"><b>{{index .TraceCounts "info"}}</b> info</li>
      </ul>
      <p class="bx-muted r-verdict-note">{{.VerdictTextEn}}</p>
    </a>
    {{end}}
  </section>

  {{with .Scan}}
  <section class="r-section" id="exposure">
    <div class="r-section-head">
      <h2>Vulnerability exposure</h2>
      <div class="r-filters no-print" role="group" aria-label="Filter">
        <button type="button" class="bx-chip" data-filter="all" aria-pressed="true">all</button>
        <button type="button" class="bx-chip" data-filter="attention" aria-pressed="false">needs action</button>
        <button type="button" class="bx-chip" data-filter="fixed" aria-pressed="false">fixed</button>
      </div>
    </div>

    {{range .Advisories}}
    <div class="bx-card r-adv">
      <div class="r-adv-head">
        <span class="bx-badge is-red is-plain">{{.Severity}}</span>
        <strong class="r-adv-name">{{.Name}}</strong>
        {{range .Vulnerabilities}}<a class="bx-chip" href="{{.URL}}" rel="noreferrer">{{.CVE}}</a>{{end}}
        <span class="bx-chip">CVSS {{.CVSS.Version}} · {{printf "%.1f" .CVSS.Score}}</span>
        <span class="bx-faint mono r-adv-date">published {{.Published}}</span>
      </div>
      <p class="r-adv-summary">{{index .Summary "en"}}</p>
      <div class="r-fixed-grid">
        {{range .Branches}}<div class="r-fixed"><span class="mono bx-faint">PHP {{.Branch}}</span><span class="mono {{if .Fixed}}r-ok{{else}}r-bad{{end}}">{{if .Fixed}}≥ {{.Fixed}}{{else}}no release{{end}}</span></div>{{end}}
      </div>
    </div>
    {{end}}

    {{if not .Instances}}
    <div class="bx-card bx-card-body bx-muted">No PHP builds were found on this machine.</div>
    {{end}}
  </section>
  {{end}}

  {{if .Instances}}
  <div class="bx-card r-instances">
    {{range .Instances}}
    <details class="r-inst" data-status="{{.Status}}" {{if ne .Status "fixed"}}open{{end}}>
      <summary>
        <span class="bx-badge" data-status="{{.Status}}">{{.StatusEn}}</span>
        <span class="r-inst-path mono">{{.Path}}{{if .Stale}} <em class="r-stale">replaced</em>{{end}}</span>
        <span class="r-inst-meta mono"><span class="bx-faint">{{.Where}}</span> · {{.SAPI}} · <b>{{if .Version}}{{.Version}}{{else}}?{{end}}</b></span>
        <span class="r-inst-env">{{.Environment}}</span>
      </summary>
      <div class="r-inst-body">
        <dl class="bx-kv">
          <dt>target</dt><dd class="mono">{{.TargetKind}} · {{.Target}}{{if .OS.Pretty}} · {{.OS.Pretty}}{{end}}</dd>
          <dt>version</dt><dd class="mono">{{if .Version}}{{.Version}}{{else}}?{{end}} <span class="bx-faint">({{.VersionSource}})</span></dd>
          {{with .Package}}<dt>package</dt><dd class="mono">{{.Name}} {{.Version}} <span class="bx-faint">({{.Manager}}{{if .Source}}, source {{.Source}}{{end}})</span></dd>{{end}}
          {{with .Changelog}}<dt>changelog</dt><dd class="mono">{{.}}</dd>{{end}}
          {{with .Aliases}}<dt>aliases</dt><dd class="mono">{{join . ", "}}</dd>{{end}}
          {{with .PIDs}}<dt>running</dt><dd class="mono">pid {{range $i, $p := .}}{{if $i}}, {{end}}{{$p}}{{end}}</dd>{{end}}
          {{with .Fingerprints}}<dt>fingerprint</dt><dd class="mono">{{join . ", "}}</dd>{{end}}
        </dl>
        {{range .Notes}}<p class="r-note">! {{.}}</p>{{end}}
        {{range .Views}}
        <div class="r-assess">
          <div class="r-assess-head"><strong>{{.Advisory}}</strong> <span class="bx-faint">— {{.Reason}} · confidence {{.Confidence}}</span></div>
          <ul class="r-evidence">
            {{range .Evidence}}<li data-verdict="{{.Verdict}}"><span class="r-ev-mark"></span><span class="r-ev-kind mono">{{.Kind}}</span><span class="r-ev-detail">{{.Detail}}</span></li>{{end}}
          </ul>
          {{if .Steps}}
          <div class="r-steps">
            <div class="bx-eyebrow">What to do</div>
            <ol>{{range .Steps}}<li>{{.}}</li>{{end}}</ol>
          </div>
          {{end}}
        </div>
        {{end}}
      </div>
    </details>
    {{end}}
  </div>
  {{end}}

  {{with .Scan}}{{if .Warnings}}
  <div class="r-warnings">{{range .Warnings}}<p>! {{.}}</p>{{end}}</div>
  {{end}}{{end}}

  {{if .Trace}}
  <section class="r-section" id="trace">
    <div class="r-section-head">
      <h2>Intrusion trace</h2>
      <span class="bx-faint mono">{{.Trace.Stats.FilesScanned}} files · {{.Trace.Stats.LogFiles}} logs · {{.Trace.Stats.LogLines}} lines · since {{.Trace.Since.Format "2006-01-02"}}</span>
    </div>

    <div class="r-trace-grid">
      <div class="r-findings">
        {{if not .Findings}}<div class="bx-card bx-card-body bx-muted">No findings.</div>{{end}}
        {{range .Findings}}
        <article class="bx-card r-finding" data-sev="{{.Severity}}">
          <header>
            <span class="bx-badge" data-sev="{{.Severity}}">{{.SevEn}}</span>
            <h3>{{index .Title "en"}}</h3>
            <span class="bx-faint mono r-rule">{{.Rule}}</span>
          </header>
          <div class="r-loc mono">{{.Loc}}{{if .Count}} <span class="bx-faint">×{{.Count}}</span>{{end}}{{with .Time}} <span class="bx-faint">· {{fmtTime .}}</span>{{end}}</div>
          {{with .Snippet}}<pre class="bx-code r-snippet">{{.}}</pre>{{end}}
          {{if .Why}}<p class="bx-muted r-why">{{index .Why "en"}}</p>{{end}}
          {{with .Details}}<ul class="r-details mono">{{range .}}<li>{{.}}</li>{{end}}</ul>{{end}}
        </article>
        {{end}}
      </div>
      <aside class="bx-card r-tl">
        <div class="bx-card-head"><span class="bx-eyebrow">Timeline</span><span class="bx-faint mono">UTC</span></div>
        <div class="bx-card-body">
          {{if not .Days}}<p class="bx-faint">No timestamped events.</p>{{end}}
          <ol class="bx-timeline">
            {{range .Days}}<li class="day">{{.Day}}</li>{{range .Events}}<li class="ev" data-sev="{{.Severity}}"><time>{{clock .Time}}</time><span class="dot"></span><span class="what">{{.Summary}}{{with .Path}}<span class="path">{{.}}</span>{{end}}</span></li>{{end}}{{end}}
          </ol>
        </div>
      </aside>
    </div>

    <div class="bx-card r-scope">
      <div class="bx-card-head"><span class="bx-eyebrow">Scope</span></div>
      <div class="bx-table-wrap"><table class="bx-table">
        <thead><tr><th>Web root</th><th>Files</th><th>Found via</th></tr></thead>
        <tbody>{{range .Trace.Webroots}}<tr><td class="mono">{{.Path}}</td><td class="mono">{{.Files}}</td><td class="bx-faint">{{.Source}}</td></tr>{{else}}<tr><td colspan="3" class="bx-faint">—</td></tr>{{end}}</tbody>
      </table></div>
    </div>
    {{if .Trace.Warnings}}<div class="r-warnings">{{range .Trace.Warnings}}<p>! {{.}}</p>{{end}}</div>{{end}}
  </section>
  {{end}}

  <section class="r-method bx-card bx-card-body">
    <div class="bx-eyebrow">How to read this report</div>
    <p>Bastion only reads files and process metadata; it changed nothing on this machine. <b>Fixed</b> means a fixed upstream version, a vendor package at or above the vendor's fixed version, a package changelog naming the CVE, or code that only the fix introduces. <b>Likely vulnerable</b> means a build Bastion cannot prove patched (for example an end-of-life branch or a package whose changelog is silent). <b>Unknown</b> means there was not enough information — ask the vendor. Trace findings are indicators, not proof; a clean trace does not prove a clean system.</p>
  </section>
</main>

<footer class="bx-wrap r-foot mono bx-faint">
  <span>bastion {{.Version}} · {{if .Scan}}{{.Scan.Schema}}{{end}}{{if .Trace}} · {{.Trace.Schema}}{{end}}</span>
  <span>Contains host details — share with care.</span>
</footer>

<script type="application/json" id="bastion-data">{{.DataJSON}}</script>
<script>{{.JS}}</script>
</body>
</html>
